# ==============================================================================
# Marginalia Production Environment Configuration Template
# Copy this file to .env in the deploy directory: cp .env.example .env
# Fill in your secrets and production domain before starting containers.
# ==============================================================================

# ------------------------------------------------------------------------------
# Domain & Automated TLS (Let's Encrypt)
# ------------------------------------------------------------------------------
# Your public fully qualified domain name (e.g. reader.example.com)
DOMAIN_NAME=reader.example.com

# Optional contact email registered with ACME (Let's Encrypt / ZeroSSL).
# Note: Routine expiration reminder emails have been retired by Let's Encrypt
# (renewals are fully automated by Caddy). This email is only used for urgent
# security revocation notices or fallback CA account registration.
ACME_EMAIL=admin@example.com


# ------------------------------------------------------------------------------
# Database Configuration (MySQL 8.4 LTS)
# ------------------------------------------------------------------------------
DB_NAME=marginalia
DB_USER=marginalia_user

# Secure passwords: Generate using `openssl rand -base64 24`
DB_PASSWORD=replace_with_strong_database_password
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password

# SSL settings for internal Docker bridge network
DB_USE_SSL=false
DB_ALLOW_PUBLIC_KEY=true

# ------------------------------------------------------------------------------
# Application & Security Settings
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod

# Production safety: dev-mode must always be false in production
DEV_MODE=false

# Session cookie security: true mandates Secure flag (HTTPS required)
SECURE_COOKIE=true

# Frontend public base URL (matches your public domain with HTTPS scheme)
FRONTEND_URL=https://reader.example.com

# Authorized user emails (comma-separated list of whitelisted Google/GitHub emails)
AUTH_WHITELIST_EMAILS=your-email@example.com

# ------------------------------------------------------------------------------
# OAuth2 Client Credentials
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Client ID and Secret (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth App Client ID and Secret (from GitHub Developer Settings)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ------------------------------------------------------------------------------
# Feed Crawler Configuration
# ------------------------------------------------------------------------------
# Crawl interval (e.g. 15m for 15 minutes)
CRAWLER_INTERVAL=15m

# Maximum allowed feed download size to prevent resource exhaustion attacks
CRAWLER_MAX_FEED_SIZE=10MB
