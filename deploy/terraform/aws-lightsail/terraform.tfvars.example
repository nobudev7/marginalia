# ==============================================================================
# Marginalia — AWS Lightsail Configuration Template
# Copy this file to "terraform.tfvars" and customize for your deployment:
#   cp terraform.tfvars.example terraform.tfvars
#
# DO NOT commit "terraform.tfvars" with sensitive settings to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AWS Region & Lightsail Compute Instance
# ------------------------------------------------------------------------------
# AWS region where your Lightsail instance will be created.
# Note: Lightsail is NOT available in us-west-1 (N. California).
# Supported US regions: "us-west-2" (Oregon), "us-east-1" (N. Virginia), "us-east-2" (Ohio).
aws_region = "us-east-1"

# Availability Zone (leave null to use default "<aws_region>a").
# availability_zone = "us-east-1a"

# Name of the Lightsail instance and base prefix for related resources.
instance_name = "marginalia"

# OS Blueprint. Debian 12 is recommended for reliability and stability.
blueprint_id = "debian_12"

# Bundle size (specifies CPU, RAM, and SSD storage).
# Available standard Linux options (IPv4 included):
#   - "micro_3_0" : 1 GB RAM, 2 vCPUs, 40 GB SSD (~$7/mo, recommended budget plan with swap)
#   - "small_3_0" : 2 GB RAM, 2 vCPUs, 60 GB SSD (~$12/mo, comfortable headroom)
bundle_id = "micro_3_0"

# Size in GB for the automated swapfile created on first boot (set 0 to disable).
# Strongly recommended on 1 GB instances to prevent out-of-memory container terminations.
swap_size_gb = 2

# Directory on the remote host where the Marginalia repository will reside.
app_dir = "/opt/marginalia"

# ------------------------------------------------------------------------------
# 2. SSH Access & Firewall Hardening
# ------------------------------------------------------------------------------
# Name of the Lightsail key pair resource.
key_pair_name = "marginalia-key"

# Path to your local SSH public key to import.
public_key_path = "~/.ssh/id_ed25519.pub"

# Restrict SSH (port 22) access to your specific IP address or CIDR range.
# Default ["0.0.0.0/0"] allows SSH from anywhere.
# To restrict strictly to your home/office IP:
# ssh_allowed_cidrs = ["203.0.113.195/32"]
ssh_allowed_cidrs = ["0.0.0.0/0"]

# ------------------------------------------------------------------------------
# 3. Resource Tags
# ------------------------------------------------------------------------------
tags = {
  Environment = "production"
  Application = "marginalia"
}
